// esta es la buena
datasource db {
	provider = "postgresql"
}

enum GameStatus {
	WAITING
	PLAYING
	FINISHED
}

enum GameType {
	FREE_PLAY
	ADD42
}

enum Outcome {
	WIN
	LOSE
	TIE
}

model User {
	id			String @id @default(cuid())
	username	String @unique
	email		String @unique
	avatar		String?
	createdAt	DateTime @default(now())
	updatedAt	DateTime @updatedAt

	playerGames	PlayerGame[]
	stats		UserStats[]

	// Only needed if using next-auth Prisma adapter:
	// accounts    Account[]
	// sessions    Session[]
	// emailVerified DateTime?
}

model Game {
	id			String @id @default(cuid())
	status		GameStatus @default(WAITING)
	gameType	GameType
	createdAt	DateTime @default(now())

	players		PlayerGame[]

	@@index([status, gameType])
}

model PlayerGame {
	id			String @id @default(cuid())
	userId		String
	gameId		String
	outcome		Outcome?
	totalPoints	Int @default(0)
	rank		Int?
	joinedAt	DateTime @default(now())

	user		User @relation(fields: [userId], references: [id])
	game		Game @relation(fields: [gameId], references: [id])

	rolls		Roll[]

	@@unique([userId, gameId])
	@@index([gameId])
}

model Roll {
	id			String @id @default(cuid())
	playerId	String
	value		Int
	round		Int
	createdAt	DateTime @default(now())

	player		PlayerGame @relation(fields: [playerId], references: [id])

	@@index([playerId])
}

model UserStats {
	id			String @id @default(cuid())
	userId		String
	gameType	GameType
	gamesPlayed	Int @default(0)
	wins		Int @default(0)
	losses		Int @default(0)
	ties		Int @default(0)
	totalPoints Int @default(0)
	updatedAt	DateTime @default(now())

	user		User @relation(fields: [userId], references: [id])

	@@unique([userId, gameType])
	@@index([gameType, totalPoints])
}